COMPOSE_PROJECT_NAME=avia-social
SECRET_KEY=REPLACE_USING_SETUP
ENCRYPTION_KEY_SALT=REPLACE_USING_SETUP
POSTGRES_PASSWORD=REPLACE_USING_SETUP
DATABASE_URL=postgres://avia:REPLACE_USING_SETUP@postgres:5432/avia
DJANGO_SETTINGS_MODULE=config.settings.avia
ALLOWED_HOSTS=localhost,127.0.0.1,app
APP_URL=http://localhost:8088
AVIA_PORT=8088
AVIA_HTTPS=false
AVIA_PUBLISH_ENABLED=false
SIGNUP_MODE=closed
EMAIL_BACKEND_TYPE=console
AVIA_GITHUB_WEBHOOK_SECRET=

# Responsable real de esta instalación y correo público para privacidad/soporte
AVIA_LEGAL_OPERATOR=
AVIA_LEGAL_CONTACT_EMAIL=
